{
  "name": "handle-tiktok",
  "version": "0.1.0",
  "private": true,
  "description": "TikTok username generator with pluggable availability checks.",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "minify": "node scripts/minify.js",
    "minify:css": "cleancss -o public/css/style.min.css public/css/style.css",
    "minify:js": "node scripts/minify-js.js",
    "build": "npm run minify && python3 i18n/build.py"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "terser": "^5.51.2"
  }
}
